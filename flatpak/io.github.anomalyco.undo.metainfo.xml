<?xml version="1.0" encoding="UTF-8"?>
<component type="console-application">
  <id>io.github.anomalyco.undo</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>undo</name>
  <summary>Rückgängig für Linux-Befehle</summary>
  <description>
    <p>
      undo zeichnet Filesystem-Änderungen eines Befehls auf und macht sie per interaktiver Abfrage rückgängig.
      Ideal für rm, mv, cp und Datei-Modifikationen – ohne vorher an git oder Backup denken zu müssen.
    </p>
    <p>Nutzung: `undo run &lt;befehl&gt;` und danach `undo` für die interaktive Auswahl.</p>
  </description>
  <launchable type="desktop-id">io.github.anomalyco.undo.desktop</launchable>
  <provides>
    <binary>undo</binary>
  </provides>
  <developer id="io.github.anomalyco">
    <name>anomalyco</name>
  </developer>
  <url type="homepage">https://github.com/anomalyco/undo</url>
  <url type="bugtracker">https://github.com/anomalyco/undo/issues</url>
  <categories>
    <category>System</category>
    <category>Utility</category>
  </categories>
  <releases>
    <release version="0.2.0" date="2026-09-07">
      <description>
        <p>Interaktive Abfrage beim Rückgängig machen, AUR &amp; Flatpak Support.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1" />
</component>
