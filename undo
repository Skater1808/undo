#!/usr/bin/env bash

UNDO_VERSION="0.4.2"

UNDO_DIR="${UNDO_DIR:-$HOME/.undo}"
ENTRIES_DIR="$UNDO_DIR/entries"
STATE_DIR="$UNDO_DIR/state"

mkdir -p "$ENTRIES_DIR" "$STATE_DIR"

_red()    { printf '\033[0;31m%s\033[0m\n' "$*"; }
_green()  { printf '\033[0;32m%s\033[0m\n' "$*"; }
_yellow() { printf '\033[0;33m%s\033[0m\n' "$*"; }
_bold()   { printf '\033[1m%s\033[0m\n' "$*"; }

_undo_snap() {
    local d="$1" o="$2"
    [ -d "$d" ] || { : > "$o"; return; }
    find "$d" -xdev \( -path "$HOME/.undo" -o -path "$HOME/.undo/*" \) -prune -o \
        -maxdepth 8 -printf '%T@\t%m\t%u:%g\t%p\0' 2>/dev/null | \
        LC_ALL=C sort -z -t$'\t' -k4 > "$o" 2>/dev/null || : > "$o"
}

_undo_bkup() {
    local s="$1" d="$2"; mkdir -p "$d"
    local f
    while IFS= read -r -d '' f; do
        [ -f "$f" ] || continue
        cp -a "$f" "$d/${f//\//__}" 2>/dev/null || true
    done < <(tr '\0' '\n' < "$s" | cut -f4 | sort -u | while IFS= read -r p; do
        [ -n "$p" ] && printf '%s\0' "$p"
    done)
}

_undo_process() {
    local ts="$1" cmd="$2" pwd="$3"
    local s="$HOME/.undo/state/$ts"
    [ -d "$s" ] && [ -f "$s/before.snap" ] || return
    _undo_snap "$pwd" "$s/after.snap"
    cmp -s "$s/before.snap" "$s/after.snap" 2>/dev/null && { rm -rf "$s"; return; }
    local bf af new del mod total=0
    bf=$(tr '\0' '\n' < "$s/before.snap" | cut -f4 | sort -u)
    af=$(tr '\0' '\n' < "$s/after.snap" | cut -f4 | sort -u)
    new=$(comm -13 <(echo "$bf") <(echo "$af"))
    del=$(comm -23 <(echo "$bf") <(echo "$af"))
    mod=""
    while IFS= read -r f; do
        [ -z "$f" ] && continue; [ -f "$f" ] || continue
        local bl al
        bl=$(grep -zF "$f" "$s/before.snap" 2>/dev/null | tr '\0' '\n' | head -1)
        al=$(grep -zF "$f" "$s/after.snap" 2>/dev/null | tr '\0' '\n' | head -1)
        [ -n "$bl" ] && [ -n "$al" ] && [ "$bl" != "$al" ] && mod="${mod}${f}"$'\n'
    done <<< "$bf"
    [ -n "$new" ] && total=$((total + $(echo "$new" | grep -c .)))
    [ -n "$del" ] && total=$((total + $(echo "$del" | grep -c .)))
    [ -n "$mod" ] && total=$((total + $(echo "$mod" | grep -c .)))
    [ "$total" -eq 0 ] && { rm -rf "$s"; return; }
    local e="$HOME/.undo/entries/${ts}.undo"
    {
        printf '%s\t%s\t%s\t%s\n' "$ts" "$cmd" "$pwd" "$total"
        while IFS= read -r f; do [ -z "$f" ] && continue; printf 'CREATE\t%s\n' "$f"; done <<< "$new"
        while IFS= read -r f; do [ -z "$f" ] && continue; printf 'DELETE\t%s\n' "$f"; done <<< "$del"
        while IFS= read -r f; do
            [ -z "$f" ] && continue; local bl al p o
            bl=$(grep -zF "$f" "$s/before.snap" 2>/dev/null | tr '\0' '\n' | head -1)
            al=$(grep -zF "$f" "$s/after.snap" 2>/dev/null | tr '\0' '\n' | head -1)
            p=$(echo "$bl" | cut -f2); o=$(echo "$bl" | cut -f3)
            printf 'MODIFY\t%s\t%s\t%s\n' "$f" "$p" "$o"
        done <<< "$mod"
    } > "$e"
    rm -f "$s/before.snap" "$s/after.snap"
}

# --- Shell hook: PROMPT_COMMAND-based, no DEBUG trap ---
do_hook() {
    cat <<'HOOK'
# undo v0.4.2 - automatic filesystem undo
# eval "$(undo --hook)"
mkdir -p "$HOME/.undo/entries" "$HOME/.undo/state"

_undo_s() {
    local d="$1" o="$2"
    [ -d "$d" ] || { : > "$o"; return; }
    find "$d" -xdev \( -path "$HOME/.undo" -o -path "$HOME/.undo/*" \) -prune -o \
        -maxdepth 8 -printf '%T@\t%m\t%u:%g\t%p\0' 2>/dev/null | \
        LC_ALL=C sort -z -t$'\t' -k4 > "$o" 2>/dev/null || : > "$o"
}
_undo_b() {
    local s="$1" d="$2"; mkdir -p "$d"
    local f
    while IFS= read -r -d '' f; do
        [ -f "$f" ] || continue
        cp -a "$f" "$d/${f//\//__}" 2>/dev/null || true
    done < <(tr '\0' '\n' < "$s" | cut -f4 | sort -u | while IFS= read -r p; do
        [ -n "$p" ] && printf '%s\0' "$p"
    done)
}
_undo_p() {
    mkdir -p "$HOME/.undo/entries" "$HOME/.undo/state"
    local ts="$1" cmd="$2" pwd="$3"
    local s="$HOME/.undo/state/$ts"
    [ -d "$s" ] && [ -f "$s/before.snap" ] || return
    _undo_s "$pwd" "$s/after.snap"
    cmp -s "$s/before.snap" "$s/after.snap" 2>/dev/null && { rm -rf "$s"; return; }
    local bf af new del mod total=0
    bf=$(tr '\0' '\n' < "$s/before.snap" | cut -f4 | sort -u)
    af=$(tr '\0' '\n' < "$s/after.snap" | cut -f4 | sort -u)
    new=$(comm -13 <(echo "$bf") <(echo "$af"))
    del=$(comm -23 <(echo "$bf") <(echo "$af"))
    mod=""
    while IFS= read -r f; do
        [ -z "$f" ] && continue; [ -f "$f" ] || continue
        local bl al
        bl=$(grep -zF "$f" "$s/before.snap" 2>/dev/null | tr '\0' '\n' | head -1)
        al=$(grep -zF "$f" "$s/after.snap" 2>/dev/null | tr '\0' '\n' | head -1)
        [ -n "$bl" ] && [ -n "$al" ] && [ "$bl" != "$al" ] && mod="${mod}${f}"$'\n'
    done <<< "$bf"
    [ -n "$new" ] && total=$((total + $(echo "$new" | grep -c .)))
    [ -n "$del" ] && total=$((total + $(echo "$del" | grep -c .)))
    [ -n "$mod" ] && total=$((total + $(echo "$mod" | grep -c .)))
    [ "$total" -eq 0 ] && { rm -rf "$s"; return; }
    local e="$HOME/.undo/entries/${ts}.undo"
    {
        printf '%s\t%s\t%s\t%s\n' "$ts" "$cmd" "$pwd" "$total"
        while IFS= read -r f; do [ -z "$f" ] && continue; printf 'CREATE\t%s\n' "$f"; done <<< "$new"
        while IFS= read -r f; do [ -z "$f" ] && continue; printf 'DELETE\t%s\n' "$f"; done <<< "$del"
        while IFS= read -r f; do
            [ -z "$f" ] && continue; local bl al p o
            bl=$(grep -zF "$f" "$s/before.snap" 2>/dev/null | tr '\0' '\n' | head -1)
            al=$(grep -zF "$f" "$s/after.snap" 2>/dev/null | tr '\0' '\n' | head -1)
            p=$(echo "$bl" | cut -f2); o=$(echo "$bl" | cut -f3)
            printf 'MODIFY\t%s\t%s\t%s\n' "$f" "$p" "$o"
        done <<< "$mod"
    } > "$e"
    rm -f "$s/before.snap" "$s/after.snap"
}

_undo_hook() {
    # Skip first prompt (shell startup)
    [ "${_UNDO_STARTED:-0}" = 0 ] && { _UNDO_STARTED=1; return; }
    # Self-heal: recreate data dirs if deleted
    mkdir -p "$HOME/.undo/entries" "$HOME/.undo/state"
    # Process previous command if pending
    if [ -f "$HOME/.undo/pending" ]; then
        local _p; _p=$(cat "$HOME/.undo/pending"); rm -f "$HOME/.undo/pending"
        local _ts _cmd _pwd
        _ts=$(echo "$_p" | cut -f1)
        _cmd=$(echo "$_p" | cut -f2)
        _pwd=$(echo "$_p" | cut -f3)
        _undo_p "$_ts" "$_cmd" "$_pwd"
    fi
    # Snapshot for next command
    local _ts; _ts=$(date +%s%N)
    local _cmd=""
    if [ -n "$BASH_VERSION" ]; then
        _cmd=$(HISTTIMEFORMAT='%s\t' history 1 2>/dev/null | sed 's/^[ ]*[0-9]*[ ]*[0-9]*[ ]*//')
    elif [ -n "$ZSH_VERSION" ]; then
        _cmd=$(fc -ln -1 2>/dev/null | sed 's/^[ ]*//')
    fi
    # Skip undo's own commands
    [[ "$_cmd" == undo* ]] && return
    local _snap="$HOME/.undo/state/$_ts"
    mkdir -p "$_snap"
    _undo_s "$PWD" "$_snap/before.snap"
    _undo_b "$_snap/before.snap" "$_snap/backup"
    printf '%s\t%s\t%s\n' "$_ts" "$_cmd" "$PWD" > "$HOME/.undo/pending"
}

if [ -n "$BASH_VERSION" ]; then
    PROMPT_COMMAND="_undo_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
elif [ -n "$ZSH_VERSION" ]; then
    autoload -U add-zsh-hook
    add-zsh-hook precmd _undo_hook
fi
HOOK
}

# --- Undo execution ---

undo_entry() {
    local file="$ENTRIES_DIR/$1"
    [ -f "$file" ] || { _red "Entry not found: $1"; return 1; }
    local snap_dir="$STATE_DIR/${1%.undo}"
    local hdr; hdr=$(head -1 "$file")
    local cmd; cmd=$(echo "$hdr" | cut -f2)
    local wdir; wdir=$(echo "$hdr" | cut -f3)
    _bold "Undoing: $cmd"
    [ -d "$wdir" ] && cd "$wdir"
    local creates=() deletes=() modifies=()
    while IFS=$'\t' read -r type rest; do
        case "$type" in
            CREATE) creates+=("$rest") ;;
            DELETE) deletes+=("$rest") ;;
            MODIFY) modifies+=("$rest") ;;
        esac
    done < <(tail -n +2 "$file")
    for f in "${creates[@]}"; do
        [ -e "$f" ] && echo "  remove $f" && rm -rf "$f"
    done
    for entry in "${modifies[@]}"; do
        local orig_file perms owner
        orig_file=$(echo "$entry" | cut -f1)
        perms=$(echo "$entry" | cut -f2)
        owner=$(echo "$entry" | cut -f3)
        local saved="$snap_dir/backup/${orig_file//\//__}"
        if [ -f "$saved" ]; then
            echo "  restore $orig_file"
            cp -a "$saved" "$orig_file"
            chmod "$perms" "$orig_file" 2>/dev/null || true
            chown "$owner" "$orig_file" 2>/dev/null || true
        fi
    done
    for f in "${deletes[@]}"; do
        local saved="$snap_dir/backup/${f//\//__}"
        if [ -f "$saved" ]; then
            echo "  restore $f"
            mkdir -p "$(dirname "$f")"
            cp -a "$saved" "$f"
        fi
    done
    rm -f "$file"
    rm -rf "$snap_dir"
    _green "Done."
}

list_entries() {
    local n="${1:-10}" count=0
    for entry in $(find "$ENTRIES_DIR" -maxdepth 1 -name '*.undo' -printf '%f\n' 2>/dev/null | sort -rn | head -"$n"); do
        local hdr; hdr=$(head -1 "$ENTRIES_DIR/$entry")
        local ts cmd changes
        ts=$(echo "$hdr" | cut -f1)
        cmd=$(echo "$hdr" | cut -f2)
        changes=$(echo "$hdr" | cut -f4)
        local sec=$((ts / 1000000000))
        local t; t=$(date -d "@$sec" '+%H:%M:%S' 2>/dev/null || echo "$sec")
        count=$((count + 1))
        printf '  \033[1m%2d\033[0m  %s  %s  (%s changes)\n' "$count" "$t" "$cmd" "$changes"
    done
    if [ $count -eq 0 ]; then _yellow "  (empty)"; fi
    return 0
}

do_interactive() {
    local entries=()
    while IFS= read -r e; do [ -n "$e" ] && entries+=("$e"); done \
        < <(find "$ENTRIES_DIR" -maxdepth 1 -name '*.undo' -printf '%f\n' 2>/dev/null | sort -rn)
    [ ${#entries[@]} -eq 0 ] && { _yellow "Nothing to undo."; return; }
    local lines=()
    for i in "${!entries[@]}"; do
        local hdr; hdr=$(head -1 "$ENTRIES_DIR/${entries[$i]}")
        local ts cmd chg; ts=$(echo "$hdr" | cut -f1); cmd=$(echo "$hdr" | cut -f2); chg=$(echo "$hdr" | cut -f4)
        local sec=$((ts / 1000000000))
        local t; t=$(date -d "@$sec" '+%H:%M:%S' 2>/dev/null || echo "$sec")
        lines+=("[$((i+1))] $t  $cmd  ($chg changes)")
    done
    local chosen=""
    if command -v fzf >/dev/null 2>&1 && [ -t 1 ] && [ -t 0 ]; then
        local sel
        sel=$(printf '%s\n' "${lines[@]}" | fzf --prompt="undo> " --height=15 --reverse --border 2>/dev/null) || true
        [ -z "$sel" ] && { _yellow "Cancelled."; return; }
        chosen=$(echo "$sel" | sed -n 's/^\[\([0-9]*\)\].*/\1/p')
    else
        _bold "Last ${#entries[@]} commands:"
        echo ""
        for i in "${!lines[@]}"; do
            [ $i -eq 0 ] && printf '  \033[0;32m%s\033[0m  <- latest\n' "${lines[$i]}" \
                          || printf '  %s\n' "${lines[$i]}"
        done
        echo ""
        printf "Select [1-%d, q=cancel, Enter=1]: " "${#entries[@]}"
        read -r chosen || true
        [ -z "$chosen" ] && chosen=1
        [[ "$chosen" == [qQ] ]] && { _yellow "Cancelled."; return; }
    fi
    [[ "$chosen" =~ ^[0-9]+$ ]] && [ "$chosen" -ge 1 ] && [ "$chosen" -le ${#entries[@]} ] || { _red "Invalid: $chosen"; return 1; }
    local target="${entries[$((chosen-1))]}"
    _yellow "Selected: $(head -1 "$ENTRIES_DIR/$target" | cut -f2)"
    if [ -t 0 ]; then
        printf "Undo? [y/N]: "
        read -r c || true
        case "$c" in j|J|y|Y|yes|ja) ;; *) _yellow "Cancelled."; return ;; esac
    fi
    undo_entry "$target"
}

do_undo_last() {
    local latest; latest=$(find "$ENTRIES_DIR" -maxdepth 1 -name '*.undo' -printf '%f\n' 2>/dev/null | sort -n | tail -1)
    [ -z "$latest" ] && { _yellow "Nothing to undo."; return; }
    undo_entry "$latest"
}

do_clear() {
    rm -rf "$ENTRIES_DIR"/* "$STATE_DIR"/* 2>/dev/null || true
    rm -f "$UNDO_DIR/pending"
    _green "History cleared."
}

usage() {
    cat <<EOF
undo $UNDO_VERSION - Automatic filesystem undo

Setup:
  eval "\$(undo --hook)"

Add to ~/.bashrc or ~/.zshrc.

Usage:
  undo              Show last 10 commands, pick one to undo
  undo <N>          Undo command N directly
  undo --last       Undo the last command
  undo list [N]     Show last N commands (default: 10)
  undo clear        Clear history
  undo --hook       Print shell hook code
  undo --help       Show this help
  undo --version    Show version
EOF
}

case "${1:-}" in
    list|ls|history) list_entries "${2:-10}" ;;
    clear|reset)     do_clear ;;
    --last|-y)       do_undo_last ;;
    --hook)          do_hook ;;
    --version|-V)    echo "undo $UNDO_VERSION" ;;
    -h|--help|help)  usage ;;
    "")              do_interactive ;;
    [0-9]*)
        entries_sorted=($(find "$ENTRIES_DIR" -maxdepth 1 -name '*.undo' -printf '%f\n' 2>/dev/null | sort -rn))
        if [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le ${#entries_sorted[@]} ]; then
            undo_entry "${entries_sorted[$(( $1 - 1 ))]}"
        else
            _red "Invalid: $1 (1-${#entries_sorted[@]})"
            exit 1
        fi
        ;;
    *) _red "Unknown: $1"; usage; exit 1 ;;
esac
